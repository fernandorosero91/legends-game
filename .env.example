# 🎮 LEGENDS: Environment Variables Example
# Copia este archivo a .env y completa con tus credenciales

# InsForge Configuration
VITE_INSFORGE_BASE_URL=https://your-app.region.insforge.app
VITE_INSFORGE_ANON_KEY=your-anon-key-here
VITE_INSFORGE_PROJECT_ID=your-project-id-here
VITE_INSFORGE_PROJECT_NAME=your-project-name
VITE_INSFORGE_REGION=your-region

# Development
VITE_APP_NAME=LEGENDS
VITE_APP_VERSION=1.0.0